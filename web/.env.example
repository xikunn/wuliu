# Mock 演示（默认）：不复制本文件，或仅保留 VITE_API_MODE=mock

# 真后端联调（npm run dev + smart-street-light :8080）
# Vite 已代理 REST/WS；VITE_API_BASE 留空走相对路径，避免 CORS
VITE_API_MODE=http
VITE_API_BASE=
VITE_WS_BASE=ws://localhost:8080

# 生产构建直连后端时改为实际 host，例如：
# VITE_API_BASE=http://192.168.1.10:8080
# VITE_WS_BASE=ws://192.168.1.10:8080
